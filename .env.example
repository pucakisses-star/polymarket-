# Polygon wallet private key (hex, with or without 0x prefix). KEEP THIS SECRET.
PRIVATE_KEY=

# Polymarket CLOB host
CLOB_HOST=https://clob.polymarket.com

# Chain ID: 137 = Polygon mainnet
CHAIN_ID=137

# Signature type:
#   0 = EOA (you sign with the EOA private key)
#   1 = Polymarket proxy (email/magic login)
#   2 = Browser wallet proxy (Metamask)
SIGNATURE_TYPE=0

# Address of your Polymarket-funded account. For SIGNATURE_TYPE=0, leave blank
# to use the EOA address derived from PRIVATE_KEY. For proxy types, set this
# to the proxy address shown in the Polymarket UI.
FUNDER_ADDRESS=

# Strategy: mean_reversion | market_make | manual
STRATEGY=mean_reversion

# Comma-separated list of market condition_ids or token_ids to watch.
# Find these via https://gamma-api.polymarket.com/markets
MARKETS=

# Max USDC to risk per single order
MAX_ORDER_USDC=5

# Max total open exposure across all positions (USDC)
MAX_TOTAL_USDC=50

# Loop interval in seconds
POLL_INTERVAL=30

# DRY_RUN=true logs orders but never sends them. Set to false to trade live.
DRY_RUN=true

# PAPER_TRADING=true runs against live Polymarket market data but simulates
# fills against a virtual balance. No PRIVATE_KEY or USDC required.
PAPER_TRADING=false
PAPER_STARTING_CASH=1000
PAPER_STATE_FILE=paper_state.json

# Strategy-specific:
# mean_reversion: buy when price < lower, sell when price > upper
MR_LOWER=0.40
MR_UPPER=0.60

# market_make: place buy at mid-spread and sell at mid+spread
MM_SPREAD=0.02
MM_SIZE=5
