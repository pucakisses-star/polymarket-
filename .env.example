# ============ mode ============
# paper = simulate fills against live orderbooks; no key, no money (default)
# live  = real orders with real USDC; requires PRIVATE_KEY and ACK_LIVE_RISK
MODE=paper

# Required for MODE=live: explicit acknowledgment that real money is at risk
ACK_LIVE_RISK=false

# ============ connection (live mode) ============
# Polygon wallet private key. KEEP SECRET. Never commit this file.
PRIVATE_KEY=
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
# 0 = EOA key | 1 = Polymarket email/Magic proxy | 2 = browser-wallet proxy
SIGNATURE_TYPE=0
# For SIGNATURE_TYPE 1/2: the proxy ("deposit") address shown in the Polymarket UI
FUNDER_ADDRESS=

# ============ what to trade ============
# market_maker | fair_value | complement_arb
STRATEGY=market_maker

# Comma-separated markets. Find entries with: python -m bot.discover <terms>
#   market_maker / fair_value:  MARKETS=<token_id>
#   complement_arb:             MARKETS=<yes_token>:<no_token>
MARKETS=

# fair_value only: your probability estimate per token (token=prob,...)
FAIR_VALUES=

# ============ engine ============
POLL_INTERVAL=5
STATE_FILE=bot_state.json

# ============ risk limits ============
MAX_ORDER_USDC=10        # max notional of any single order
MAX_POSITION_USDC=25     # max capital committed to one market (held + resting buys)
MAX_TOTAL_USDC=100       # max capital at risk across everything
MAX_DRAWDOWN_PCT=10      # kill switch: halt + cancel all if equity drops this % from peak

# Exchange minimums (Polymarket rejects orders below these)
MIN_SIZE_SHARES=5
MIN_NOTIONAL_USDC=1

# ============ paper account ============
PAPER_CASH=1000
ORDER_TTL_SEC=300        # simulated orders expire after this many seconds

# ============ market_maker ============
MM_QUOTE_SIZE=10         # shares per quote
MM_MIN_HALF_SPREAD=0.01  # never quote tighter than this from (skewed) mid
MM_MAX_BOOK_SPREAD=0.10  # pull quotes entirely if the book is wider than this
MM_INVENTORY_LIMIT=50    # max shares of inventory; buying stops at the cap
MM_SKEW_INTENSITY=1.0    # how hard quotes lean against inventory (0 = off)

# ============ fair_value ============
FV_MIN_EDGE=0.05         # trade only when |market - your estimate| >= this
FV_KELLY_FRACTION=0.25   # fraction of full Kelly to size with
FV_BANKROLL=100          # sizing bankroll for live mode (paper uses actual cash)

# ============ complement_arb ============
ARB_MIN_EDGE=0.01        # min riskless profit per $1 pair to act on
